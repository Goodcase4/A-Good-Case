<style>

    a{
     text-decoration: none;
     color: inherit;
     font-family: var(--poppins);
     font-weight: var(--semibold);
    
    }
/* ACCORDION I MENU */
summary{
    cursor: pointer;
}
    header{
        padding-left: var(--padding-mobile);
        padding-right: var(--padding-mobile);
        display: flex; flex-direction: row;
        padding-top: 50px;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
       z-index: 1000;
       background: transparent;
       margin-top: 0;
       align-items: center;
    }
   
    .nav_menu {
     display: none;
     color: white;
     }
     .icons_navbar{display: none;}
     #burger {
  display: none;

}

input + label {
  position: fixed;
  top: 40px;
  right: 40px;
  height: 20px;
  width: 15px;
    z-index: 2000;
}
span {
  position: absolute;
  width: 44.79px;
  height: 4.2px;
  top: 50%;
  margin-top: 1px;
  left: 0;
  display: block;
}
span:first-child {
  top: 0px;
}
.second_span{
top:13.5px;
}
span:last-child {
  top: 27px;
}
.burger_span{
    height: 36.64px;
}

label:hover {
  cursor: pointer;
}

input:checked + label span {
  opacity: 0;
  top: 50%;
}
input:checked + label span:first-child {
  opacity: 1;
  transform: rotate(405deg);
}
input:checked + label span:last-child {
  opacity: 1;
  transform: rotate(-405deg);
}

input ~ nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 0;
  z-index: 1500;
  overflow: hidden;
  transition: 0.5s;
}
input ~ nav {
  z-index: 1000;

}
input ~ nav li {
  list-style-type: none;
  opacity: 0;
  transition: 0.1s;
  transition-delay: 0s;
}
input ~ nav a {
  text-decoration: none;
  color: black;
  font-weight: var(--semibold);
  font-family: var(--poppins);
  display: block;
  padding: 20px;
  background-color: var(--primary-bg-color);
  width: 336px;
}
input:checked ~ nav {
  height: 100%;
  transition-delay: 0s;
}
input:checked ~ nav li {
  opacity: 1;
  transition-delay: 0.5s;
}
.burgermenu{
    background-color: var(--primary-bg-color); 
  display: flex;
  align-items: center;
     
}

     /* TABLET CSS */
     @media (min-width:768px){

     }
    /* DESKTOP CSS */
    @media (min-width: 1024px){
        header{
    display: flex;
    justify-content: space-between;
    padding-left: var(--padding-desk);
    padding-right: var(--padding-desk);
    padding-top: 78.8px;

        }

          input + label {
    display: none;
  }
        .icons_navbar{
            display: flex; 
            flex-direction: row; 
            padding-left: var(--padding-desktop);
            padding-right: var(--padding-desktop);
            gap:25px; align-items: center;
            height: 25px;  
            flex-shrink: 0;
        }
        a{
         font-size: var(--h5-desk);
        }
         .burgermenu {
    display: none;
  }
  .nav_menu {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px; 
    white-space: nowrap;
  }
  .logo_header svg{
    height: 58px;
  }
    }
</style>