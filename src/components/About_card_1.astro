
---
const {img, text, overskrift} = Astro.props;
---
<article>
    <img src={img} alt="Billede">
    <section class="text">
<h2>{overskrift}</h2>
<p>{text}</p>
</section>


</article>


<!-- CSS STYLING -->


<style>

    /* MOBILE FIRST */
article 
    {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px; 
        margin: 30px;
        padding: 20px;
    }
img {
        max-width: 100%;
        height: auto;
    }
p   {
        font-family: var(--poppins);
        font-weight: var(--body-s-mobile);
    }


h2  {
        font-weight: var(--h2-mobile); 
    }
     

/* DESKTOP */

@media (min-width: 1024px) {
    article {
   flex-direction: row;
   align-items: stretch;
   
   padding: 60px 0 60px 0;
   max-width: 1400px;
   margin: 0 auto;
   background-color: var(--primary-bg-color:);
}

img {
    width: 50%;
    height: 100%;
    object-fit: cover;
    margin: 0;
    
}
.text {
    max-width: 50%;
    padding: 40px 60px;
    max-width: none;
}
}


</style>
