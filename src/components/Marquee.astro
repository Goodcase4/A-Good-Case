      <style>
        .rollingbanner {
  background: var(--primary-text-color);
  color:var(--secondary-text-color);
  font-family: var(--poppins);
  font-size: 11px;
  padding-top: 10px;
  padding-bottom: 10px;
}

.marquee_text {
  overflow: clip;
  mask-image: linear-gradient(
    to right,
    transparent,
    black 2.5rem,
    black calc(100% - 2.5rem),
    transparent
  );
}

.marquee-text-track {
  display: flex;
  padding-left: 4rem;
  gap: 4rem;
  width: max-content;
  animation: marquee-move-text 18s linear infinite;
}
@media (prefers-reduced-motion: reduce) {
  .marquee-text-track {
    animation: none;
  }
}

@keyframes marquee-move-text {
  to {
    transform: translateX(-50%);
  }
}
   /* TABLET CSS */
     @media (min-width:768px){ 
        .rollingbanner{font-size: 11.5px;}
    }
     /* DESKTOP CSS */
    @media (min-width: 1024px){ 
        .rollingbanner{
        font-size: 12px;
    }}
      </style>
