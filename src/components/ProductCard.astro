---
const {name, brand, description, bestbefore, oldprice, newprice, discount, img, beercolor, amount} = Astro.props;
---

<article>
<p>{discount}</p>

<p> {brand}</p>
<p>{bestbefore}</p>
<p>{oldprice}</p>

<p>{description}</p>

<h1>{name}</h1>
<h1>{newprice}</h1>

<p>{amount}</p>

<img>{img}</img>
<img>{beercolor}<img/>

</article>

