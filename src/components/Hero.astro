---
import "../css/custom.css";
import BtnGreenBrownGrey from "./Btn_green_brown_grey.astro";
---

<section class="hero">
  <h1>Spild aldrig<br>god øl igen</h1>
  <p>Specialøl med god smag<br>og god samvittighed</p>
  <BtnGreenBrownGrey Btn_indhold_gbg="UDFORSK SPECIALØL"></BtnGreenBrownGrey>
</section>

<style>section {
  background-image: url('/images/hero_landingpage_mobile.webp');
  background-position: center;
  background-size: cover;
  padding-top: 150px;
  padding-bottom: 50px;
  padding-left: var(--padding-mobile);
}

h1{
    color: var(--secondary-text-color);
    font-size: var(--h1-mobile);
    font-family: var(--poppins);
    font-weight: var(--bold);
    padding-bottom: 30px;
}
p{
    color: var(--secondary-text-color);
    font-size:var(--body-xs-m) ;
    font-family: var(--poppins);
    font-weight: var(--regular);
    padding-bottom: 30px;

}
@media (prefers-reduced-motion: reduce) {
  .marquee-text-track {
    animation: none;
  }
}

@keyframes marquee-move-text {
  to {
    transform: translateX(-50%);
  }
}

   /* TABLET CSS */
     @media (min-width:768px){

     }
    /* DESKTOP CSS */
    @media (min-width: 1024px){
      section{
        padding-top: 295px;
        padding-bottom: 177px;
        padding-left: 100px;
        background-size: cover;
        background-position: center;
         background-image: url('/images/hero_landingpage.webp');
      }
      h1{
        font-size: var(--h1-desk);
        padding-bottom: 40px;
        line-height: 78px;
      }
      p{
        font-size:var(--body-l-desk) ;
        padding-bottom: 40px;
      }
       
    }
</style>