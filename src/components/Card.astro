---
const { product } = Astro.props;
import "../css/costum.css"
import "../css/general.css"
---
<a href=`details/${product.id}`>
<article>
    <div class="position">
    <img src={product.beerimg} alt="productimage" class="beer">
    <img src={product.glassimg} alt="glassimage" class="glass">
    </div>
    <div class="info">
    <div class="top">
    <p>{product.brand}</p>
    <p>{product.bbf}</p>
    </div>
    <h3>{product.productname}</h3>
    <p>{product.size} {product.flavor} og {product.texture} {product.type} med en volumen på {product.vol}</p>
    <p>{product.bprice} DKK</p>
    <p>{product.price} DKK</p>
         </div>
</article>
</a>

<style>
    article {
        border: solid 10px var(--secondary-accent-color);
        font-family:var(--poppins);
        background-color: #E0DBD1;
        font-family: var(--poppins);
    }

    .top
    {
        display: flex;
        align-items: flex-end;
        gap: 62px;
    }

    a {
        color: inherit;
        text-decoration: none;
    }
    .position img {
        margin-top: 2rem;
    }

    .info {
        background-color: #F4F4F2;
        padding: 1rem;
    }

    .beer {
        max-height: 185px;
    }

    .glass {
        max-height: 128px;
    }
</style>

