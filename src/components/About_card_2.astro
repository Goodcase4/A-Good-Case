
---
const {img, text, overskrift} = Astro.props;
---
<article class="reverse_img">
<img src={img} alt="Billede">
<section class="text">
<h2>{overskrift}</h2>
<p>{text}</p>
</section>
</article>


<!-- CSS STYLING -->

<style>
article 
    {
display: flex;
        margin: 30px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px; 
        background-color: var(--primary-bg-color);
    }
p   {
        font-family: var(--poppins);
        font-weight: var(--body-s-mobile);
    }
h2  {
        font-weight: var(--h2-mobile); 
    }
     
   img {
    
        max-width: 100%;
        height: auto;
        margin: 0 auto;
   }
   .text {
    margin: 0 auto;
   }

/* DESKTOP */
@media (min-width: 1024px) {
    article {
   flex-direction: row;
   align-items: stretch;
   padding: 0;
   max-width: 1400px;
   margin: 0 auto;
   background-color: #DAD5CD;


}
 
.reverse_img img {
    flex-direction: row-reverse;
    background-color: #DAD5CD;
}
img {
    width: 50%;
    height: 100%;
    object-fit: cover;
    margin: 0;
    
}
.text {
    max-width: 50%;
    padding: 40px 60px;
    max-width: none;
}


}

</style>
