---
const {img, text, overskrift} = Astro.props;
---
<article class="reverse_img">
<img src={img} alt="Billede">
<section class="text">
<h2>{overskrift}</h2>
<p>{text}</p>
</section>
</article>


<!-- CSS STYLING -->

<style>
article 
    {
display: flex;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        background-color: var(--primary-bg-color);
    }
p   {
        font-family: var(--poppins);
        font-weight: var(--body-s-mobile);
    }
h2  {
       font-weight: var(--bold); 
        font-family: var(--poppins);
    }
     
   img {
    
        max-width: 100%;
        margin: 0 auto;
   }
   .text {
    padding: var(--padding-mobile);
    }

/* DESKTOP */
@media (min-width: 1024px) {
    article {
   flex-direction: row;
   align-items: center;
   padding: 0;
   margin: 0 auto;
   background-color: #DAD5CD;


}
 
.reverse_img img {
    flex-direction: row-reverse;
    background-color: #DAD5CD;
}
img {
    width: 50%;
    height: 100%;
    object-fit: cover;
    margin: 0;
    
}
.text {
     max-width: 50%;
    padding: 0px 120px;
}

h2 {
font-size: 32px;
margin-bottom: 15px;
}


}

</style>
