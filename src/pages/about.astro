---
//@ts-nocheck
import Layout from "../layouts/Layout.astro";
import About_card_1 from "../components/About_card_1.astro";
import About_card_2 from "../components/About_card_2.astro";
---
   <Layout>

<h1>Hvem er 
A Good Case
</h1>

  <section>
    <About_card_1 
      overskrift="Vores historie"
      
      text="Fremtiden er gylden, hvis vi træffer mere klimavenlige valg. 
      Hos A Good Case arbejder vi for at reducere spild ved at redde specialøl, 
      før de når deres best before-dato.
      Bryggerier ender ofte med øl, der ikke bliver solgt, 
      selvom kvaliteten er i top. Det opkøber vi og sælger videre til gode priser. 
      På den måde sparer vi ressourcer, reducerer CO₂ og giver øllet en ekstra chance."

      img="/src/assets/img/voreshistorie.webp"/>
  </section>
  
 <section class="reverse">
    <About_card_2
      overskrift="Hvem er vi"
      
      text="Vi er et lille team med base i Brøndby, 
      hvorfra vi sælger øl til hele Danmark, 
      både online og via lagersalg og pop-up shops.
      Vi tager også socialt ansvar gennem samarbejde 
      med Brøndby Kommune og sørger for, 
      at selv øl efter best before-datoen 
      bliver reddet via partnere som Your Local og Too Good To Go."

      img="/src/assets/img/hvemervi.webp"/>
  </section>

   <section>
    <About_card_1
      overskrift="Vores mål"
      
      text="A Good Case blev grundlagt i 2020 af Jesper, Mads og Mads. 
      I dag er vi fem ansatte med missionen: 
      Specialøl med god smag og god samvittighed.
      Siden starten har vi reddet over 1 million øl. 
      Vores sortiment skifter løbende, 
      men kvaliteten er altid høj."

      img="/src/assets/img/vores_maal.webp"/>
  </section>

</Layout>
