---
//@ts-nocheck
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Hero from "../components/Hero.astro";
import Miljo_banner from '../components/Miljo_banner.astro';
import Nyhedsbrev from '../components/Nyhedsbrev.astro';


const endpoint = "https://iaduahadfyssoyyvutnz.supabase.co/rest/v1/Produkter?"

const options={
    headers:{
        apikey: "sb_publishable_Xqf0QS3qNkh-fM6NTJ0VdA_00QLo3XC"
    }
}

const data = await fetch(endpoint, options).then((response) => response.json());

---

<Layout>
    <Hero/>
    <section>
        {data.map((product) => <Card {product} />)}
    </section>
    <Miljo_banner/>
	<Nyhedsbrev/>
</Layout>

<style>
    section {
        display: grid;
        gap: 2.8rem;
        padding: 2rem;
    }

    @media (min-width: 1024px) {
       section {
        grid-template-columns: repeat(3, 1fr);
        gap: 60px;
        padding: var(--padding-desk);
       }
    }
</style>


