---
//@ts-nocheck
const {logocolor} = Astro.props;
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Hero from "../components/Hero.astro";
import Miljo_banner from '../components/Miljo_banner.astro';
import Nyhedsbrev from '../components/Nyhedsbrev.astro';
import Header from "../components/Header.astro";


const endpoint = "https://iaduahadfyssoyyvutnz.supabase.co/rest/v1/Produkter?&limit=3"

const options={
    headers:{
        apikey: "sb_publishable_Xqf0QS3qNkh-fM6NTJ0VdA_00QLo3XC"
    }
}

const data = await fetch(endpoint, options).then((response) => response.json());

---

<Layout>
    <Header
		/>
    <Hero />
    <section>
        {data.map((product) => <Card {product} />)}
    </section>
    <Miljo_banner/>
	<Nyhedsbrev/>
</Layout>

<style>
    section {
        display: grid;
        gap: 20px;
        padding: var(--padding-mobile);
    }

      @media (min-width: 768px) {
        section {
            display: grid;
        }
    }

    @media (min-width: 1024px) {
       section {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 60px;
        padding: var(--padding-desk);
    }
    }
</style>


